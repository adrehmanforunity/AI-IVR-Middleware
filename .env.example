# HTTP
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Created automatically under the process working directory if missing
LOG_DIR=./logs
API_KEY=change-me

# Superadmin UI (seeded into SQLite on first boot if no users exist; then change in UI)
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=changeme
SESSION_TTL_HOURS=12
# Set true when serving the UI over HTTPS
COOKIE_SECURE=false

# SQLite (file is created automatically)
SQLITE_PATH=./data/iim.db

# Asterisk secrets — env wins over anything stored in SQLite
AMI_PASSWORD=
ARI_PASSWORD=

# Optional bootstrap if SQLite has no asterisk_targets row yet
ASTERISK_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=iim
ARI_BASE_URL=http://127.0.0.1:8088
ARI_USER=iim
# IIM PBX stations (phones this app uses), not inbound DIDs
# IIM_OWNED_EXT_FROM=3001
# IIM_OWNED_EXT_TO=3999

